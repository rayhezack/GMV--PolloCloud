      "css": ".ds-tabs{display:inline-flex;height:38px;padding:3px;border-radius:999px;background:#e9eef4}.ds-tabs button{font-family:'Inter Variable',Inter,'PingFang SC',sans-serif;height:32px;padding:0 15px;border:0;border-radius:999px;background:transparent;color:#4c5d73;font-size:12px;cursor:pointer}.ds-tabs button[aria-pressed=true]{color:var(--primary,#533afd);background:white;box-shadow:0 1px 3px #0d253d0d}.ds-tabs button:hover{color:var(--primary,#533afd)}.ds-tabs button:focus-visible{outline:2px solid var(--primary,#533afd);outline-offset:3px;}"
    },
    {
      "name": "Navigation rail",
      "kind": "nav",
      "refersTo": "navigation-item-active",
      "description": "默认紧凑 SVG 图标入口，标签通过辅助名称保留。",
      "html": "<nav class=\"ds-nav\" aria-label=\"看板导航\"><button aria-label=\"GMV 趋势\" aria-current=\"page\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"M3 3v18h18M7 14l4-4 4 3 5-7\"/></svg></button><button aria-label=\"付费类型\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"M3 10h18\"/></svg></button></nav>",
      "css": ".ds-nav{display:inline-flex;flex-direction:column;gap:5px;padding:6px;border:0;border-radius:14px;background:white}.ds-nav button{display:grid;place-items:center;width:38px;height:39px;border:0;border-radius:8px;color:#61718a;background:transparent;cursor:pointer}.ds-nav button[aria-current=page],.ds-nav button:hover,.ds-nav button:focus-visible{background:#eeebff;color:var(--primary,#533afd)}.ds-nav button:focus-visible{outline:2px solid var(--primary,#533afd);outline-offset:3px;}"
    },
    {
      "name": "Positive change",
      "kind": "chip",
      "refersTo": "change-positive",
      "description": "仅用于实际变化方向。",
      "html": "<span class=\"ds-change\">+12.4%</span>",
      "css": ".ds-change{font-family:'Inter Variable',Inter,'PingFang SC',sans-serif;display:inline-flex;align-items:center;white-space:nowrap;padding:3px 5px;border-radius:4px;background:#edf8f2;color:#217451;font-size:11px;font-weight:450;font-variant-numeric:tabular-nums;line-height:1.3}"
    },
    {
      "name": "Entity trend card",
      "kind": "card",
      "refersTo": "metric-card",
      "description": "当前归因维度的多线日均趋势；静态样式示意，无业务数据。",
      "html": "<article class=\"ds-card\"><header><h3>创作模型趋势</h3><span class=\"ds-range\">近 30 天 · 日均 GMV</span></header><div class=\"ds-legend\"><span>● 模型 A</span><span>● 模型 B</span></div><svg class=\"ds-plot\" viewBox=\"0 0 340 224\" role=\"img\" aria-label=\"多模型日均趋势示意\"><path d=\"M20 40H320M20 100H320M20 160H320\" stroke=\"#e8edf3\" stroke-dasharray=\"3 4\"/><path d=\"M20 150 65 125 110 135 155 90 200 102 245 55 290 45 320 27\" fill=\"none\" stroke=\"#533afd\" stroke-width=\"2\"/><path d=\"M20 175 65 155 110 165 155 125 200 140 245 115 290 105 320 90\" fill=\"none\" stroke=\"#9884db\" stroke-width=\"2\"/></svg></article>",
      "css": ".ds-card{font-family:'Inter Variable',Inter,'PingFang SC',sans-serif;max-width:500px;background:white;color:#0d253d;border:0;border-radius:14px;overflow:hidden}.ds-card header{padding:20px 20px 0}.ds-card h3{margin:0;font-size:13px;font-weight:550;line-height:1.4}.ds-range{display:block;margin-top:8px;font-size:11px;color:#61718a}.ds-legend{display:flex;gap:12px;margin:10px 20px 4px;font-size:10px;color:#533afd}.ds-legend span+span{color:#9884db}.ds-plot{display:block;width:calc(100% - 24px);height:224px;margin:12px 12px 16px}"
    },
    {
      "name": "Finance SVG comparison",
      "kind": "custom",
      "refersTo": "metric-card",
      "description": "日视图零轴组合图与三摘要；周月改为动态纵轴的单折线并隐藏摘要。静态预览为日视图。",
      "html": "<article class=\"ds-finance\"><div class=\"ds-finance-stats\"><div>区间日均<strong>$24,800</strong></div><div>较上周<strong class=\"ds-finance-direction\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#217451\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M12 19V5m-7 7 7-7 7 7\"/></svg>12.4%</strong></div><div>上周同期日均<strong>$22,064</strong></div></div><svg class=\"ds-finance-plot\" viewBox=\"0 0 360 224\" role=\"img\" aria-label=\"当前与上周同期收入及变化量示意\"><defs><pattern id=\"ds-finance-up\" width=\"6\" height=\"6\" patternUnits=\"userSpaceOnUse\" patternTransform=\"rotate(26)\"><rect width=\"6\" height=\"6\" fill=\"#e4dfff\"/><path d=\"M0 0V6\" stroke=\"#cec5ff\" stroke-width=\"4\"/></pattern><pattern id=\"ds-finance-down\" width=\"6\" height=\"6\" patternUnits=\"userSpaceOnUse\" patternTransform=\"rotate(26)\"><rect width=\"6\" height=\"6\" fill=\"#fbe2e9\"/><path d=\"M0 0V6\" stroke=\"#efbecd\" stroke-width=\"4\"/></pattern></defs><path d=\"M32 30H340M32 90H340M32 150H340M32 210H340\" stroke=\"#edf0f5\"/><text x=\"20\" y=\"213\" fill=\"#61718a\" font-size=\"10\">0</text><g fill=\"url(#ds-finance-up)\"><rect x=\"48\" y=\"178\" width=\"16\" height=\"30\" rx=\"4\"/><rect x=\"148\" y=\"165\" width=\"16\" height=\"43\" rx=\"4\"/><rect x=\"248\" y=\"175\" width=\"16\" height=\"33\" rx=\"4\"/></g><g fill=\"url(#ds-finance-down)\"><rect x=\"98\" y=\"188\" width=\"16\" height=\"20\" rx=\"4\"/><rect x=\"198\" y=\"181\" width=\"16\" height=\"27\" rx=\"4\"/></g><path d=\"M32 150 90 120 150 135 210 100 270 105 340 65\" fill=\"none\" stroke=\"#b9b5c8\" stroke-width=\"2\" stroke-dasharray=\"6 6\"/><path d=\"M32 130 90 135 150 100 210 120 270 75 340 40\" fill=\"none\" stroke=\"#533afd\" stroke-width=\"2\"/></svg></article>",
      "css": ".ds-finance{font-family:'Inter Variable',Inter,'PingFang SC',sans-serif;max-width:650px;border:0;border-radius:16px;background:white;color:#0d253d}.ds-finance-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;padding:8px 0 16px}.ds-finance-stats>div{display:grid;gap:9px;border:0;border-radius:12px;background:#f6f9fc;padding:14px;font-size:11px;color:#61718a}.ds-finance-stats strong{font-size:24px;font-weight:500;letter-spacing:-.025em;color:#0d253d;font-variant-numeric:tabular-nums}.ds-finance-plot{display:block;width:100%;height:224px}@media(max-width:600px){.ds-finance-stats>div{padding:10px}.ds-finance-stats strong{font-size:20px}}.ds-finance-direction{display:flex;align-items:center;gap:8px}.ds-finance-direction svg{flex-shrink:0}"
    },
    {
      "name": "Detail metric alignment",
      "kind": "custom",
      "refersTo": "metric-card",
      "description": "固定标签、数值、变化三行；成本用相对百分比，成本占比用绝对 pp。静态示意。",
      "html": "<div class=\"ds-detail-metrics\"><div><span>GMV</span><strong>$24,800</strong><small><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M12 19V5m-7 7 7-7 7 7\"/></svg>12.4%</small></div><div><span>模型成本</span><strong>$8,420</strong><small><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M12 19V5m-7 7 7-7 7 7\"/></svg>8.1%</small></div><div><span>成本 / GMV</span><strong>34.0%</strong><small><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M12 19V5m-7 7 7-7 7 7\"/></svg>1.2 pp</small></div></div>",
      "css": ".ds-detail-metrics{font-family:'Inter Variable',Inter,'PingFang SC',sans-serif;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;color:#0d253d;background:white;border:0;padding:22px 0}.ds-detail-metrics>div{display:grid;grid-template-rows:20px 32px 16px;align-items:center;gap:7px;min-width:0}.ds-detail-metrics span{display:flex;align-items:center;height:20px;color:#61718a;font-size:11px}.ds-detail-metrics strong{font-size:24px;line-height:32px;font-weight:450;letter-spacing:-.02em;white-space:nowrap;font-variant-numeric:tabular-nums}.ds-detail-metrics small{display:inline-flex;align-items:center;gap:2px;font-size:10px;color:#61718a;white-space:nowrap}@media(max-width:480px){.ds-detail-metrics{gap:8px}.ds-detail-metrics strong{font-size:19px}}"
    }
  ],
  "narrative": {
    "northStar": "Stripe Revenue Workbench",
    "overview": "Stripe 产品界面的克制与密度服务于重复收入诊断：深海军蓝建立阅读层级，紫色标记当前操作和主要数据，白色工作表面承载图形、金额与比较。导航、卡片、控件与菜单以表面和间距分区，不使用外边框。Bento 是有共同对齐关系的分析分组，卡片内的留白首先保障图形可读。\n\n布局和直接交互表达关系，只在数据口径、缺失或操作后果影响判断时增加说明。以付费类型的新实现为当前系统证据；全局导航和 GMV 趋势继承同一世界。未迁移页面及通用主题中残留的旧墨色、旧紫色不构成新页面的配色授权。",
    "keyCharacteristics": [
      "紫色主线与深海军蓝文字，白色图表表面。",
      "紧凑 Bento、表格对齐与足够的绘图区高度。",
      "默认窄图标导航，可按需展开。",
      "导航、指标卡、图卡、控件与菜单无外边框；浅线仅保留内部结构。"
    ],
    "rules": [
      {
        "name": "The One Primary Rule",
        "body": "紫色用于主要数据、当前选择与关键操作；主 GMV 比较线使用灰色，模型成本使用薰衣草紫。多实体趋势可使用已定义的分类序列色区分曲线，不把分类颜色扩展成卡片主题。",
        "section": "colors"
      },
      {
        "name": "The Layout Explains Rule",
        "body": "Avoid unnecessary secondary labels and descriptions. Let the layout do the explaining itself.",
        "section": "typography"
      },
      {
        "name": "The Flat Work Surface Rule",
        "body": "分析卡片静止时无阴影、无外边框；用白色表面、浅色背景与间距分组，浅线仅用于内部结构，浮层以柔和阴影表达临时层级。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 将金额、比较值与图形放进同一分析表面，让读者直接核对。",
      "Do 使用制表数字、右对齐数值和浅灰表格分隔线。",
      "Do 保证柱图和折线图有完整绘图区，移动端保留表格自身横向滚动。",
      "Do 检查菜单展开与键盘焦点态，使用紫色焦点提示。",
      "Do 仅对会影响判断的数据范围、缺失值和口径保留说明。"
    ],
    "donts": [
      "Don't 给导航、指标卡、图卡、控件或菜单添加外边框，也不使用黑色默认框线。",
      "Don't 在收入分析中恢复环形图、独立右侧 KPI 卡或重复数字的分析摘要带。",
      "Don't 用装饰性副标题、眉题或第二层标签补充布局已经表达的关系。",
      "Don't 将成本 / GMV 标为利润率，也不要用颜色掩盖无数据与真实零值的区别。",
      "Don't 将旧主题残留、黑色默认焦点或旧环形图样式写成新系统规范。"
    ]
  }
}
