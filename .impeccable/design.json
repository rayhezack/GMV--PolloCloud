      "kind": "button",
      "refersTo": "button-primary",
      "description": "紫色主操作。",
      "html": "<button class=\"ds-primary\">应用筛选</button>",
      "css": ".ds-primary{font-family:'Inter Variable',Inter,'PingFang SC',sans-serif;background:var(--primary,#533afd);color:white;border:0;border-radius:8px;padding:8px 16px;min-height:36px;font-size:14px;font-weight:500;cursor:pointer}.ds-primary:hover{filter:brightness(.97)}.ds-primary:active{filter:brightness(.92)}.ds-primary:focus-visible{outline:2px solid var(--primary,#533afd);outline-offset:3px;}.ds-primary:disabled{opacity:.5;pointer-events:none}"
