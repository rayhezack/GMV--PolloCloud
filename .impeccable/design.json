      "css": ".ds-ghost{font-family:'Inter Variable',Inter,'PingFang SC',sans-serif;height:32px;padding:0 12px;border:0;border-radius:8px;background:transparent;color:#61718a;font-size:12px;cursor:pointer}.ds-ghost:hover{background:rgb(0 0 0 / 3%)}.ds-ghost:active{background:rgb(0 0 0 / 8%)}.ds-ghost:focus-visible{outline:2px solid var(--primary,#533afd);outline-offset:3px;}"
