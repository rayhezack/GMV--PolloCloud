    {
      "name": "Entity search",
      "kind": "input",
      "refersTo": "search",
      "description": "Bencho 原位展开搜索：34px 收起，224px 展开；减少动态效果时立即切换。",
      "html": "<label class=\"ds-expand-search\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 18 18\" fill=\"none\" stroke=\"currentColor\" aria-hidden=\"true\"><circle cx=\"7.6\" cy=\"7.6\" r=\"5.4\"/><path d=\"M11.6 11.6 15.4 15.4\"/></svg><input type=\"search\" aria-label=\"搜索模型\" placeholder=\"搜索模型\"></label>",
      "css": ".ds-expand-search{display:inline-flex;align-items:center;gap:8px;width:34px;height:34px;border:0;border-radius:999px;background:#f6f9fc;color:#61718a;overflow:hidden;transition:width 200ms}.ds-expand-search svg{margin-left:9px;flex-shrink:0}.ds-expand-search input{font-family:'Inter Variable',Inter,'PingFang SC',sans-serif;min-width:0;width:170px;border:0;outline:0;background:transparent;color:#0d253d;opacity:0;font-size:12px}.ds-expand-search:focus-within{width:224px;box-shadow:0 0 0 2px #d8d1ff}.ds-expand-search:focus-within input{opacity:1}@media(prefers-reduced-motion:reduce){.ds-expand-search{transition:none}}"
    },
    {
      "name": "Borderless select",
      "kind": "custom",
      "refersTo": "income-select",
      "description": "全部收入包含主动付费、自动续订和 API；触发器与菜单无外边框。原生 details 仅预览展开状态。",
      "html": "<details class=\"ds-select\"><summary>全部收入<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></summary><div class=\"ds-options\"><button aria-pressed=\"true\">全部收入</button><button>主动付费</button><button>自动续订</button><button>API 收入</button></div></details>",
      "css": ".ds-select{font-family:'Inter Variable',Inter,'PingFang SC',sans-serif;position:relative;width:202px;color:#0d253d;font-size:12px}.ds-select summary{display:flex;justify-content:space-between;align-items:center;min-height:36px;padding:0 12px;list-style:none;border:0;border-radius:999px;background:white;cursor:pointer}.ds-select summary::-webkit-details-marker{display:none}.ds-select summary:hover{background:#f6f9fc}.ds-select summary:focus-visible{outline:none;background:#eeebff}.ds-select[open] svg{transform:rotate(180deg)}.ds-select svg{transition:transform 200ms}.ds-options{position:relative;margin-top:4px;padding:4px;border:0;border-radius:8px;background:white;box-shadow:0 8px 24px rgb(13 37 61 / 10%)}.ds-options button{font-family:'Inter Variable',Inter,'PingFang SC',sans-serif;display:block;text-align:left;width:100%;padding:6px 8px;border:0;border-radius:6px;background:white;color:#0d253d;font-size:12px}.ds-options button[aria-pressed=true]{color:var(--primary,#533afd)}.ds-options button:hover,.ds-options button:focus-visible{outline:none;background:#eeebff;color:var(--primary,#533afd)}@media(prefers-reduced-motion:reduce){.ds-select svg{transition:none}}"
    },
