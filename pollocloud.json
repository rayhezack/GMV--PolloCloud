{
  "name": "pollo-ai",
  "dir": "dist",
  "spa": true,
  "worker": "worker/index.ts",
  "immutable": ["/assets/*"],
  "cron": [
    { "schedule": "30 9 * * *", "path": "/api/cron/daily-pay-type" },
